{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCloudFrontOAC",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::thirdtool-fe-prod/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "<CLOUDFRONT_DISTRIBUTION_ARN>"
        }
      }
    }
  ]
}
